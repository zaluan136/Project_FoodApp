<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_basket_sheet" android:orientation="vertical"
    android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="24dp">
    <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:background="@drawable/bg_sheet_handle" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Giỏ hàng của bạn" android:textColor="#193B2B" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvBasketStore" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#6F8075" android:textSize="14sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fillViewport="false" android:overScrollMode="ifContentScrolls">
        <LinearLayout android:id="@+id/basketItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_surface" android:orientation="vertical" android:padding="16dp" />
    </ScrollView>
    <TextView android:id="@+id/tvEmptyBasket" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:padding="16dp" android:text="Chưa có món nào. Hãy chọn món bạn thích nhé!" android:textColor="#6F8075" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tạm tính" android:textColor="#728378" android:textSize="13sp" />
            <TextView android:id="@+id/tvSheetTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#193B2B" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCheckout" android:layout_width="150dp" android:layout_height="52dp" android:background="@drawable/bg_button_green" android:text="Tiếp tục  →" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
