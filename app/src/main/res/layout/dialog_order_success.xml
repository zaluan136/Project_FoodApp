<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_delivery_dialog" android:orientation="vertical" android:gravity="center_horizontal" android:padding="28dp">
    <TextView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_success_icon" android:gravity="center" android:text="✓" android:textColor="#168755" android:textSize="38sp" android:textStyle="bold" android:importantForAccessibility="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="Đặt hàng thành công!" android:textColor="#193B2B" android:textSize="23sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:lineSpacingExtra="4dp" android:text="Đơn hàng của bạn đã được ghi nhận. Theo dõi trạng thái đơn trong mục Đơn hàng nhé!" android:textColor="#71867A" android:textSize="14sp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/closeSuccess" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="26dp" android:background="@drawable/bg_button_green" android:text="Đã hiểu" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
</LinearLayout>
